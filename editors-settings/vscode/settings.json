{
  // VSCode settings optimized for macOS Sequoia
  // --- UI & UX ---
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Monaco, Menlo, monospace",
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.showFoldingControls": "always",
  "editor.stickyScroll.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Spinel",
  "workbench.startupEditor": "none",
  "workbench.reduceMotion": "on",
  "workbench.enableExperiments": false,
  "window.title": "${activeEditorFull}${separator}${rootName}",
  "explorer.confirmDelete": false,

  // --- Editor behavior ---
  "editor.tabCompletion": "on",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": true,
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // --- Performance ---
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.suggestOnTriggerCharacters": false,
  "editor.quickSuggestions": { "other": false, "comments": false, "strings": false },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/log/**": true,
    "**/vendor/bundle/**": true,
    "**/.bundle/**": true,
    "**/storage/**": true,
    "**/coverage/**": true,
    "**/public/assets/**": true,
    "**/.ruby-lsp/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/tmp": true,
    "**/log": true,
    "**/vendor/bundle": true,
    "**/.bundle": true,
    "**/storage": true,
    "**/coverage": true,
    "**/public/assets": true,
    "**/.ruby-lsp": true
  },
  "search.followSymlinks": false,

  // --- Telemetry ---
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "extensions.ignoreRecommendations": true,

  // --- Git ---
  "git.confirmSync": false,
  "git.autofetch": false,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",

  // --- Ruby (mise + LSP) ---
  "rubyLsp.rubyVersionManager": { "identifier": "mise" },
  "rubyLsp.formatter": "auto",
  "rubyLsp.indexing": {
    "excludedPatterns": [
      "**/vendor/**", "**/node_modules/**", "**/tmp/**", "**/log/**",
      "**/storage/**", "**/public/assets/**"
    ]
  },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },

  // --- Integrated terminal ---
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', Monaco, Menlo, monospace",
  "terminal.integrated.gpuAcceleration": "auto",

  // --- AI ---
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "chat.viewSessions.orientation": "stacked"
}
